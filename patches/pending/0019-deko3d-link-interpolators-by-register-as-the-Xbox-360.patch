   // --- Shaders
+  uint32_t mascara_vs = ps ? InfoDe(*ps).interpoladores : 0u;
+  if (ps) variante_ps |= RemapeoInterpoladores(p, *ps, mascara_vs);
   const DkShader* vs = ShaderDe(*p.vs, especializacion,
-                                REXCVAR_GET(nfsmw_dk_todas_las_salidas) ? kTodasLasSalidas
-                                : ps                                    ? InfoDe(*ps).interpoladores
-                                                                        : 0u);
+                                REXCVAR_GET(nfsmw_dk_todas_las_salidas) ? kTodasLasSalidas : mascara_vs);
   const DkShader* fs = ps ? ShaderDe(*ps, especializacion, 0, variante_ps) : (fs_vacio_valido_ ? &fs_vacio_ : nullptr);
   if (!vs || !fs) {
     return Rechazar(60, "shader sin DKSH");
