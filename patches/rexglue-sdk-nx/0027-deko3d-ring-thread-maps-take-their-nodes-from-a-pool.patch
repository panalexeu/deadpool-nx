Subject: [PATCH] deko3d: the ring thread's per-frame maps take their nodes from a pool

---
--- a/include/rex/x360/deko/geometria.h
+++ b/include/rex/x360/deko/geometria.h
@@ -44,6 +44,8 @@
 #include <utility>
 #include <vector>
 
+#include <rex/x360/deko/pool_nodos.h>
+
 // Nucleo lives in the universal SDK (rex::deko3d). Forward-declare it there and import the SDK's deko types into
 // NFS's deko namespace, so this header's unqualified Nucleo is the SDK's, not a phantom local one.
 namespace rex::deko3d { class Nucleo; }
@@ -168,7 +170,10 @@
     uint64_t trabajo;
   };
   std::deque<Pendiente> pendientes_;
-  std::unordered_map<uint64_t, Entrada> tabla_;
+  // Its nodes from a pool (PoolNodos): thousands of one-off ranges come and go each frame.
+  std::unordered_map<uint64_t, Entrada, std::hash<uint64_t>, std::equal_to<uint64_t>,
+                     PoolNodos<std::pair<const uint64_t, Entrada>>>
+      tabla_;
   struct Rapida {
     uint64_t clave = 0;
     Entrada* entrada = nullptr;
--- a/include/rex/x360/deko/render.h
+++ b/include/rex/x360/deko/render.h
@@ -573,7 +573,9 @@
   uint32_t oclusion_siguiente_ = 0;
   uint64_t oclusion_directas_ = 0;      // results read before their work finished (nfsmw_dk_oclusion_directa)
   uint64_t oclusion_envio_parcial_ = ~0ull;  // dibujados_ at the last partial submit for a waiting game
-  std::unordered_map<uint32_t, ConsultaDk> oclusion_abiertas_;     // by base: started, not ended
+  std::unordered_map<uint32_t, ConsultaDk, std::hash<uint32_t>, std::equal_to<uint32_t>,
+                     deko::PoolNodos<std::pair<const uint32_t, ConsultaDk>>>
+      oclusion_abiertas_;  // by base: started, not ended (one node per query: from a pool)
   std::deque<ConsultaDk> oclusion_pendientes_;                     // ended, the GPU has not finished them
   std::unordered_map<uint64_t, uint64_t> oclusion_listas_;         // by ticket: counted, not asked for yet
   uint64_t oclusion_ticket_ = 0;
