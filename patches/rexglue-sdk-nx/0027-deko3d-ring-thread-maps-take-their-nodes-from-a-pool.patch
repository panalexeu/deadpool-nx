   if (!nuevo && it->second != origen) {
     REXLOG_WARN("[deko3d] remapeo de interpoladores: colision del identificador {:08X}; se dibuja sin remapear", id);
     return 0;
--- a/include/rex/x360/deko/pool_nodos.h
+++ b/include/rex/x360/deko/pool_nodos.h
@@ -0,0 +1,75 @@
+#pragma once
+// deadpool-nx: a node pool for the std::unordered_maps the GPU ring thread fills and empties every frame (the geometry
+// store's table, the open occlusion queries). With the default allocator each new key was a malloc and each erase a
+// free: ~7 % of the ring thread in dense scenes (perf_report.py). Here a node comes from a free list, refilled 256 at a
+// time; nodes go back to the list, never to the system (the pool keeps its peak). Anything but a single object (the
+// bucket arrays) goes to operator new as usual. The maps keep their node-based guarantees (entries never move).
+//
+// One pool per node type, without a lock: only for maps used by a single thread.
+
+#include <cstddef>
+#include <new>
+
+namespace rex::deko3d {
+
+template <class T>
+struct PoolNodos {
+  using value_type = T;
+
+  PoolNodos() noexcept = default;
+  template <class U>
+  PoolNodos(const PoolNodos<U>&) noexcept {}
+
+  T* allocate(std::size_t n) {
+    if (n != 1) {
+      return static_cast<T*>(::operator new(n * sizeof(T), std::align_val_t(alignof(T))));
+    }
+    Estado& e = estado();
+    if (!e.libre) {
+      Rellenar(e);
+    }
+    Hueco* h = e.libre;
+    e.libre = h->siguiente;
+    return reinterpret_cast<T*>(h);
+  }
+
+  void deallocate(T* p, std::size_t n) noexcept {
+    if (n != 1) {
+      ::operator delete(p, std::align_val_t(alignof(T)));
+      return;
+    }
+    Estado& e = estado();
+    Hueco* h = reinterpret_cast<Hueco*>(p);
+    h->siguiente = e.libre;
+    e.libre = h;
+  }
+
+  friend bool operator==(const PoolNodos&, const PoolNodos&) noexcept { return true; }
+  friend bool operator!=(const PoolNodos&, const PoolNodos&) noexcept { return false; }
+
+ private:
+  struct Hueco {
+    Hueco* siguiente;
+  };
+  static constexpr std::size_t kAlineacion = alignof(T) > alignof(Hueco) ? alignof(T) : alignof(Hueco);
+  static constexpr std::size_t kTam =
+      ((sizeof(T) > sizeof(Hueco) ? sizeof(T) : sizeof(Hueco)) + kAlineacion - 1) / kAlineacion * kAlineacion;
+  static constexpr std::size_t kPorBloque = 256;
+  struct Estado {
+    Hueco* libre = nullptr;
+  };
+  static Estado& estado() {
+    static Estado e;
+    return e;
+  }
+  static void Rellenar(Estado& e) {
+    auto* bloque = static_cast<unsigned char*>(::operator new(kTam * kPorBloque, std::align_val_t(kAlineacion)));
+    for (std::size_t i = kPorBloque; i-- > 0;) {
+      Hueco* h = reinterpret_cast<Hueco*>(bloque + i * kTam);
+      h->siguiente = e.libre;
+      e.libre = h;
+    }
+  }
+};
+
+}  // namespace rex::deko3d
