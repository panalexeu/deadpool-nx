From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 15 Nov 2026 14:10:00 +0200
Subject: [PATCH] XMA: log a context the game keeps kicking unchanged

Diagnostic only. In a Deadpool session a game thread kicked one XMA context ~600,000 times a second with nothing
decoded (one note repeated, the level load never finished). A context kicked 100,000 times in a row with its guest
state unchanged since the previous kick now logs its whole state once.

---
diff --git a/include/rex/audio/xma/context.h b/include/rex/audio/xma/context.h
--- a/include/rex/audio/xma/context.h
+++ b/include/rex/audio/xma/context.h
@@ -294,6 +294,12 @@
   uint32_t fin_mascara_ = 0, fin_buffer0_ = 0, fin_buffer1_ = 0;
   std::chrono::steady_clock::time_point fin_desde_{};
   bool fin_avisado_ = false;
+  // Diagnostic: the guest context as the last kick found it, and how many kicks in a row found it unchanged (the game
+  // re-kicking a context that does not move: one note repeated forever, Deadpool's level load waiting on it). Logged
+  // once per context at kVueltasAtascado.
+  uint8_t ultimo_contexto_[64] = {};
+  uint32_t vueltas_iguales_ = 0;
+  bool atasco_avisado_ = false;
   uint32_t silencio_pasadas_ = 0;
   uint8_t silencio_motivo_ = 0;
   std::atomic<bool> is_allocated_ = false;
diff --git a/src/audio/xma_context.cpp b/src/audio/xma_context.cpp
--- a/src/audio/xma_context.cpp
+++ b/src/audio/xma_context.cpp
@@ -389,6 +389,36 @@
   XMA_CONTEXT_DATA data(context_ptr);
   const XMA_CONTEXT_DATA initial_data = data;
 
+  // Diagnostic (no effect on decoding): a context kicked again and again with its guest state unchanged since the
+  // previous kick is stuck between the game and this decoder; its whole state, once.
+  constexpr uint32_t kVueltasAtascado = 100000;
+  if (std::memcmp(ultimo_contexto_, context_ptr, sizeof(ultimo_contexto_)) == 0) {
+    if (++vueltas_iguales_ == kVueltasAtascado && !atasco_avisado_) {
+      atasco_avisado_ = true;
+      const uint32_t* w = reinterpret_cast<const uint32_t*>(context_ptr);
+      std::string palabras;
+      for (int i = 0; i < 16; ++i) palabras += fmt::format(" {:08X}", rex::byte_swap(w[i]));
+      REXLOG_WARN("[xma] atasco: contexto {} pedido {} veces seguidas sin cambiar: salida valida {} lectura {} "
+                  "escritura {} de {} bloques (relleno {}), entradas {}{} actual {} lectura {} paquetes {}/{}, "
+                  "bucles {} [{}..{}], subtramas por descodificar {} pendientes {}, libres en la salida {}, error {} "
+                  "parser {}, fin pendiente {} (mascara {}), solo vaciar {}; palabras:{}",
+                  id(), kVueltasAtascado, uint32_t(data.output_buffer_valid),
+                  uint32_t(data.output_buffer_read_offset), uint32_t(data.output_buffer_write_offset),
+                  uint32_t(data.output_buffer_block_count), uint32_t(data.output_buffer_padding),
+                  uint32_t(data.input_buffer_0_valid), uint32_t(data.input_buffer_1_valid),
+                  uint32_t(data.current_buffer), uint32_t(data.input_buffer_read_offset),
+                  uint32_t(data.input_buffer_0_packet_count), uint32_t(data.input_buffer_1_packet_count),
+                  uint32_t(data.loop_count), uint32_t(data.loop_start), uint32_t(data.loop_end),
+                  uint32_t(data.subframe_decode_count), uint32_t(current_frame_remaining_subframes_),
+                  remaining_subframe_blocks_in_output_buffer_, uint32_t(data.error_status),
+                  uint32_t(data.parser_error_status), fin_pendiente_, fin_mascara_, data.IsConsumeOnlyContext(),
+                  palabras);
+    }
+  } else {
+    std::memcpy(ultimo_contexto_, context_ptr, sizeof(ultimo_contexto_));
+    vueltas_iguales_ = 0;
+  }
+
   if (!data.output_buffer_valid) {
     return true;
   }
-- 
