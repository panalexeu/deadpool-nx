From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 15 Nov 2026 21:45:00 +0200
Subject: [PATCH] deko3d: depth-only clear (bit 31 of RB_COPY_CONTROL)

Like the stencil-only clear of bit 30: a clear asked for by a game's own code with bit 31 set clears the depth and
keeps the stencil (dkCmdBufClearDepthStencil with stencil mask 0). Deadpool clears its scene depth this way before
the base pass when the depth prepass is drawn, so the base pass tests its own depth instead of the prepass's.

---
diff --git a/include/rex/x360/deko/render.h b/include/rex/x360/deko/render.h
--- a/include/rex/x360/deko/render.h
+++ b/include/rex/x360/deko/render.h
@@ -90,6 +90,7 @@
   float borrado_z = 1.0f;
   // The pending clear is of the stencil only (kCopiaSoloEstencil): the depth stays.
   bool borrado_solo_estencil = false;
+  bool borrado_solo_z = false;  // a depth-only clear (bit 31 of RB_COPY_CONTROL): the stencil is kept
   uint8_t borrado_estencil = 0;
   float borrado_color[4] = {};  // color targets: the last clear's value (pending or done)
   // The useful area (nfsmw_dk_borrar_area_util): targets are max(720, pitch) tall (1280x1280 for a 1280x720 scene,
diff --git a/src/x360/deko/destinos.cpp b/src/x360/deko/destinos.cpp
--- a/src/x360/deko/destinos.cpp
+++ b/src/x360/deko/destinos.cpp
@@ -1439,6 +1439,9 @@
   // (Direct3D's clear quad with depth writes off). Gears of War 2 clears the stencil after each light; clearing the
   // depth with it wiped the scene's depth in the middle of the frame. A full clear still pending stays full.
   const bool solo_estencil = (reg.rb_copy_control >> 30) & 0x1;
+  // Bit 31, also unused by the Xenos: a depth-only clear (the stencil is kept). Deadpool's game code asks for one
+  // before the base pass when the depth prepass was drawn, so the base pass writes and tests its own depth.
+  const bool solo_z = !solo_estencil && ((reg.rb_copy_control >> 31) & 0x1);
   EstadoBorrado& previo = borrado_previo_[profundidad->serie];
   if (saltar_repetidos && previo.dibujos == dibujados_ && previo.valor == reg.rb_depth_clear) {
     ++borrados_saltados_;
@@ -1452,6 +1455,7 @@
   profundidad->borrado_solo_estencil =
       solo_estencil && (!profundidad->borrado_pendiente || profundidad->borrado_solo_estencil);
   if (solo_estencil && !profundidad->borrado_pendiente) {
+    profundidad->borrado_solo_z = false;
     profundidad->borrado_estencil = uint8_t(reg.rb_depth_clear & 0xFF);
     profundidad->borrado_pendiente = true;
     if (REXCVAR_GET(nfsmw_dk_borrado_z_aplazado)) {
@@ -1462,6 +1466,8 @@
     HacerBorradoPendiente(*profundidad);
     return;
   }
+  // A full clear still pending stays full.
+  profundidad->borrado_solo_z = solo_z && (!profundidad->borrado_pendiente || profundidad->borrado_solo_z);
   profundidad->borrado_z = float(reg.rb_depth_clear >> 8) / 16777215.0f;
   profundidad->borrado_estencil = uint8_t(reg.rb_depth_clear & 0xFF);
   profundidad->borrado_pendiente = true;
@@ -1511,7 +1517,8 @@
   dkCmdBufSetScissors(cmd, 0, &tijera, 1);  // clears respect the scissor (HowToDeko3d.md, section 6, item 9)
   if (destino.profundidad) {
     // The clear also sets the ZCULL data of the bound depth (deko3d).
-    dkCmdBufClearDepthStencil(cmd, !destino.borrado_solo_estencil, destino.borrado_z, 0xFF, destino.borrado_estencil);
+    dkCmdBufClearDepthStencil(cmd, !destino.borrado_solo_estencil, destino.borrado_z,
+                              destino.borrado_solo_z ? 0x00 : 0xFF, destino.borrado_estencil);
   } else {
     const float* c = destino.borrado_color;
     dkCmdBufClearColorFloat(cmd, i, DkColorMask_RGBA, c[0], c[1], c[2], c[3]);
-- 
