+/*
+ * The interval in raw form, appended to <logs>/rex/perfil_muestras.bin for tools/switch/perf_report.py (which
+ * names the addresses from the ELF and finds the bottleneck). Little-endian, one block per report:
+ *   "RXP1", u32 version (1), u64 tick at the end of the interval, u64 interval ticks, u64 tick frequency,
+ *   u64 image base, u32 threads, then per thread: u16 slot, u64 thread id, char name[32], f32 CPU %,
+ *   f32 CPU % on cores 0-3, i32 priority, i32 preferred core, u64 core mask;
+ *   u32 frames, then per frame: u64 tick, u64 GPU ns, u64 GPU-wait ns, u64 recording ns (running totals);
+ *   u32 samples, then per sample: u64 tick, u16 slot, u64 pc, u64 lr, u64 frames[10].
+ * Without stack sampling the block has no samples (threads and frames only: a few KB every 10 s).
+ */
+void EscribirCrudo(u64 elapsed_ticks, u64 tick_freq, const std::vector<size_t>& order,
+                   const std::vector<Sample>& samples) {
+  const u32 nf = std::min<u32>(g_num_fotogramas.exchange(0), kMaxFotogramas);
+  FILE* f = std::fopen((std::string(RexSwitchLogDir()) + "perfil_muestras.bin").c_str(), "ab");
+  if (!f) {
+    return;
+  }
+  const auto w = [f](const void* p, size_t n) { std::fwrite(p, 1, n, f); };
+  const auto w64 = [&w](u64 v) { w(&v, 8); };
+  const auto w32 = [&w](u32 v) { w(&v, 4); };
+  w("RXP1", 4);
+  w32(1);
+  w64(armGetSystemTick());
+  w64(elapsed_ticks);
+  w64(tick_freq);
+  w64(g_base);
+  w32(u32(order.size()));
+  for (size_t i : order) {
+    const Slot& s = g_slots[i];
+    u64 tid = 0;
+    s32 prioridad = -1, preferido = -1;
+    u64 mascara = 0;
+    svcGetThreadId(&tid, s.handle.load());
+    svcGetThreadPriority(&prioridad, s.handle.load());
+    svcGetThreadCoreMask(&preferido, &mascara, s.handle.load());
+    const u16 slot = u16(i);
+    w(&slot, 2);
+    w64(tid);
+    char nombre[32] = {};
+    std::memcpy(nombre, s.name, sizeof(nombre) - 1);
+    w(nombre, 32);
+    const float cpu[5] = {float(s.cpu), float(s.core_cpu[0]), float(s.core_cpu[1]), float(s.core_cpu[2]),
+                          float(s.core_cpu[3])};
+    w(cpu, sizeof(cpu));
+    w(&prioridad, 4);
+    w(&preferido, 4);
+    w64(mascara);
+  }
+  w32(nf);
+  w(g_fotogramas, sizeof(Fotograma) * nf);
+  w32(u32(samples.size()));
+  for (const Sample& m : samples) {
+    w64(m.tick);
+    w(&m.slot, 2);
+    w64(m.pc);
+    w64(m.lr);
+    w(m.frames, sizeof(m.frames));
+  }
+  std::fclose(f);
+}
