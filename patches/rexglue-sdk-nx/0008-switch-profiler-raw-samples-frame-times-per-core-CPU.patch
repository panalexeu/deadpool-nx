+// A presented frame: its tick and the renderer's running totals (see Fotograma).
+void RexSwitchPerfFotograma(u64 tick, u64 gpu_ns, u64 espera_gpu_ns, u64 grabando_ns) {
+  const u32 i = g_num_fotogramas.fetch_add(1);
+  if (i < kMaxFotogramas) {
+    g_fotogramas[i] = {tick, gpu_ns, espera_gpu_ns, grabando_ns};
+  }
+}
