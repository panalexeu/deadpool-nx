From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 15 Nov 2026 21:20:00 +0200
Subject: [PATCH] deko3d: ZCULL from a setting (dk_zcull)

The queue was always created with ZCULL. dk_zcull (default on) turns it off, to test whether it culls a base pass
that tests GEQUAL against a depth prepass.

---
diff --git a/src/ui/deko3d/presentador.cpp b/src/ui/deko3d/presentador.cpp
--- a/src/ui/deko3d/presentador.cpp
+++ b/src/ui/deko3d/presentador.cpp
@@ -768,6 +768,11 @@
 
 }  // namespace
 
+REXCVAR_DEFINE_BOOL(dk_zcull, true, "Deko3d",
+                    "deko3d's ZCULL (hierarchical depth culling) on the queue. Off: a test, Deadpool's base pass came out "
+                    "black (culled whole) after a depth prepass with every other cause ruled out")
+    .lifecycle(rex::cvar::Lifecycle::kInitOnly);
+
 // ---- The provider
 
 std::unique_ptr<ProveedorDeko3d> ProveedorDeko3d::Crear() {
@@ -775,7 +780,7 @@
   // A deko3d failure ends the process: the core flushes before every creation and before Fatal.
   FijarRegistro([](const char* linea) { REXLOG_INFO("{}", linea); }, [] { rex::FlushLogging(); });
   std::unique_ptr<ProveedorDeko3d> p(new ProveedorDeko3d());
-  p->dispositivo_.Crear(true);
+  p->dispositivo_.Crear(REXCVAR_GET(dk_zcull));
   p->compilador_ = std::make_unique<Compilador>();
   return p;
 }
