Subject: [PATCH] deko3d: remapped pixel shaders patched from their DKSH, never compiled

A remapped pixel shader (interpolators linked by register) differs from the plain one only in the shader
program header's generic input map and the IPA input locations: checked byte for byte against uam on 2,882
library pixel shaders with random remaps. ShaderDe makes it from the base variant's DKSH in microseconds; the
console no longer compiles remapped shaders.

---
--- a/src/x360/deko/dibujos.cpp
+++ b/src/x360/deko/dibujos.cpp
@@ -143,6 +143,43 @@
 // The pixel shader's inputs re-pointed (RemapeoInterpoladores): this bit plus a hash of the remap in bits 8-31.
 constexpr uint32_t kVarianteRemapeo = 0x80;
 constexpr uint32_t kMascaraIdRemapeo = 0xFFFFFF00u;
+
+// A remapped pixel shader made from its compiled DKSH instead of compiling it again: uam's output for a pixel shader
+// whose inputs moved (SpirvAGlsl's origen_entradas) differs from the plain one only in (1) the shader program header's
+// generic input map (one byte per input location, at header + 0x18; the header is at code + 0x30) and (2) the input
+// location in each IPA instruction (bits 28-37: 0x80 + 16 x location + 4 x component). Checked byte for byte against uam
+// on 2,882 of the library's pixel shaders with random remaps (tools: scratch remap_check.py): identical in every case.
+// false (nothing changed) if the DKSH is not a single pixel shader program or a moved input would land on another.
+bool ParchearEntradasPs(std::vector<uint8_t>& dksh, std::span<const uint8_t> origen) {
+  uint32_t cabecera[6];
+  if (dksh.size() < sizeof(cabecera) || origen.size() < 32) return false;
+  std::memcpy(cabecera, dksh.data(), sizeof(cabecera));
+  const size_t codigo = cabecera[2], fin = std::min<size_t>(dksh.size(), size_t(cabecera[2]) + cabecera[3]);
+  if (cabecera[0] != 0x48534B44u || cabecera[5] != 1 || codigo + 0x80 > fin) return false;
+  const size_t sph = codigo + 0x30;
+  uint32_t tipo;
+  std::memcpy(&tipo, dksh.data() + sph, 4);
+  if ((tipo & 0x1F) != 2) return false;  // SphType 2: a pixel shader
+  uint8_t mapa[32], nuevo[32] = {};
+  std::memcpy(mapa, dksh.data() + sph + 0x18, 32);
+  for (size_t l = 0; l < 32; ++l) {
+    if (!mapa[l]) continue;
+    if (origen[l] >= 32 || nuevo[origen[l]]) return false;
+    nuevo[origen[l]] = mapa[l];
+  }
+  std::memcpy(dksh.data() + sph + 0x18, nuevo, 32);
+  for (size_t o = codigo + 0x80; o + 8 <= fin; o += 8) {
+    uint64_t w;
+    std::memcpy(&w, dksh.data() + o, 8);
+    if ((w >> 53) != 0x702) continue;  // IPA (scheduling words never have these bits)
+    const uint32_t a = uint32_t(w >> 28) & 0x3FF;
+    if (a < 0x80 || a >= 0x80 + 16 * 32) continue;
+    const uint32_t a2 = 0x80 + 16u * origen[(a - 0x80) / 16] + (a & 0xF);
+    w = (w & ~(uint64_t(0x3FF) << 28)) | (uint64_t(a2) << 28);
+    std::memcpy(dksh.data() + o, &w, 8);
+  }
+  return true;
+}
 constexpr uint32_t kPalabraInvTamano = 90;
 constexpr uint32_t kMaxVerticesPorDibujo = uint32_t(1) << 20;
 constexpr uint32_t kUboBytesVs = 256 * 16;
