+  // A remapped pixel shader: its base variant's DKSH (or the plain one's) with the inputs moved (ParchearEntradasPs).
+  // Nothing is compiled: any vertex/pixel pairing the game makes works at once, the whole game through.
+  if (!origen.empty()) {
+    const uint32_t base = variante & ~(kVarianteRemapeo | kMascaraIdRemapeo);
+    const std::vector<uint8_t>* dksh = cache_.Buscar({info.huella, espec, base});
+    if (!dksh && base) dksh = cache_.Buscar({info.huella, espec, 0});
+    if (dksh) {
+      std::vector<uint8_t> parcheado = *dksh;
+      if (ParchearEntradasPs(parcheado, origen)) {
+        ++remapeos_parcheados_;
+        return cargar(parcheado);
+      }
+    }
+    if (remapeos_fallidos_++ < 16) {
+      REXLOG_WARN("[deko3d] {}: no se pudo parchear el remapeo ({}); se dibuja sin remapear", nombre,
+                  dksh ? "DKSH inesperado" : "sin DKSH base en la cache");
+    }
+  }
