+  // interleave for stereo. The scalar loop was 9 % of the XMA thread on the console.
+  static_assert(kSamplesPerFrame % 8 == 0);
+  const float32x4_t menos_uno = vdupq_n_f32(-1.0f), uno = vdupq_n_f32(1.0f), escala = vdupq_n_f32(scale);
+  auto convertir = [&](const float* p) {
+    int16x4_t mitades[2];
+    for (int k = 0; k < 2; ++k) {
+      float32x4_t v = vld1q_f32(p + 4 * k);
+      v = vbslq_f32(vcgtq_f32(v, menos_uno), v, menos_uno);
+      v = vbslq_f32(vcltq_f32(v, uno), v, uno);
+      mitades[k] = vmovn_s32(vcvtq_s32_f32(vmulq_f32(v, escala)));
+    }
+    return vreinterpretq_s16_u8(vrev16q_u8(vreinterpretq_u8_s16(vcombine_s16(mitades[0], mitades[1]))));
