+void RenderDk::AnotarVarianteAusente(const char* nombre, uint64_t huella) {
+  ++ausentes_intervalo_;
+  if (ausentes_pendientes_.size() < 4096) {
+    ausentes_pendientes_ += fmt::format(" {} ({:016X});", nombre, huella);
+  }
+}
+
+// What the ring thread collected for the SD (the remap list, the variants the PC cache lacks), written here once per
+// report instead of at each draw.
+void RenderDk::EscribirPendientesSd() {
+  if (!remapeos_pendientes_.empty()) {
+    const std::filesystem::path ruta = rex::filesystem::GetExecutableFolder() / "cache" / "variantes_remapeo.txt";
+    if (std::FILE* f = std::fopen(ruta.string().c_str(), "a")) {
+      std::fwrite(remapeos_pendientes_.data(), 1, remapeos_pendientes_.size(), f);
+      std::fclose(f);
+    }
+    remapeos_pendientes_.clear();
+  }
+  if (ausentes_intervalo_) {
+    X360_INFORME("[deko3d] {} variantes que la cache del PC no tiene (dibujadas con la general):{}", ausentes_intervalo_,
+                 ausentes_pendientes_);
+    ausentes_intervalo_ = 0;
+    ausentes_pendientes_.clear();
+  }
+}
