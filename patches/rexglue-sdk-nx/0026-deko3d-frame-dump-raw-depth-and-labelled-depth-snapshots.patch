From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 15 Nov 2026 22:00:00 +0200
Subject: [PATCH] deko3d: frame dump: raw depth, and labelled depth snapshots

Diagnostic. Every depth image in a frame dump is also written raw (.z24s8.bin), and VolcarProfundidad puts the
current content of a depth target into the dump under a label, for comparing depth between passes (Deadpool: why the
base pass fails its GEQUAL test against the depth prepass).

---
diff --git a/include/rex/x360/destinos.h b/include/rex/x360/destinos.h
--- a/include/rex/x360/destinos.h
+++ b/include/rex/x360/destinos.h
@@ -121,6 +121,11 @@
   // larger value): what was drawn there after the resolve (a first-person weapon after its own depth clear) reaches
   // the post-processing that samples the texture. false if there was nothing to merge.
   virtual bool FusionarProfundidadPosterior() { return false; }
+  // Debugging, during a frame dump only: the depth target (RB_DEPTH_INFO, pitch) as it is now, into the dump under
+  // `etiqueta` (file base DE<etiqueta>xxx), raw values too. For comparing depth between passes.
+  virtual void VolcarProfundidad(uint32_t depth_info, uint32_t pitch, uint32_t etiqueta) {
+    (void)depth_info; (void)pitch; (void)etiqueta;
+  }
   // First uses so far: compiled shaders read from the card, and the time spent (reading them and preparing each shader
   // the first time). For telling whether a long frame was waiting for shaders.
   virtual void PrimerosUsos(uint64_t& lecturas, uint64_t& nanosegundos) const {
diff --git a/include/rex/x360/deko/render.h b/include/rex/x360/deko/render.h
--- a/include/rex/x360/deko/render.h
+++ b/include/rex/x360/deko/render.h
@@ -184,6 +184,7 @@
   bool Dibujar(const PeticionDibujo& peticion) override;  // nfsmw_dk_dibujos.cpp
   void PedirVolcado() override { volcado_pedido_ = true; }
   bool FusionarProfundidadPosterior() override;
+  void VolcarProfundidad(uint32_t depth_info, uint32_t pitch, uint32_t etiqueta) override;
   void PrimerosUsos(uint64_t& lecturas, uint64_t& nanosegundos) const override;
   EstadisticasDibujos EstadisticasDeDibujos() const override;
   void EsperarSubidas() override {}  // vertices are copied on the ring thread, before Dibujar returns
diff --git a/src/x360/deko/destinos.cpp b/src/x360/deko/destinos.cpp
--- a/src/x360/deko/destinos.cpp
+++ b/src/x360/deko/destinos.cpp
@@ -1712,6 +1712,22 @@
   OlvidarEstado();
 }
 
+void RenderDk::VolcarProfundidad(uint32_t depth_info, uint32_t pitch, uint32_t etiqueta) {
+  if (!volcando_) {
+    return;
+  }
+  ImagenDk* profundidad = DestinoProfundidad(depth_info & 0xFFF, (depth_info >> 16) & 0x1, pitch);
+  if (!profundidad) {
+    REXLOG_INFO("[deko3d] volcado: profundidad {:08X} pitch {} no existe", depth_info, pitch);
+    return;
+  }
+  AsegurarTrabajo();
+  HacerBorradoPendiente(*profundidad);  // a clear still pending is its real content
+  VolcarResuelta(*profundidad, 0xDE000000u | ((etiqueta & 0xFFF) << 12) | (depth_info & 0xFFF), 22);
+  REXLOG_INFO("[deko3d] volcado: profundidad {:08X} pitch {} ({}x{}) como etiqueta {:03X}", depth_info, pitch,
+              profundidad->ancho, profundidad->alto, etiqueta);
+}
+
 bool RenderDk::FusionarProfundidadPosterior() {
   if (!ultima_z_valida_) {
     return false;
@@ -3050,6 +3066,13 @@
     std::snprintf(nombre, sizeof(nombre), "%02u_%08X_%ux%u_g%u%s_rango_%g_%g", unsigned(n), e.base, e.ancho, e.alto,
                   e.formato_guest, profundidad ? "_z" : "", double(minimo), double(maximo));
     EscribirBmp(carpeta / (std::string(nombre) + ".bmp"), e.ancho, e.alto, bgr);
+    if (profundidad) {
+      // The raw Z24S8 words (depth in the upper 24 bits, stencil in the lower 8), row after row, for exact comparisons.
+      if (std::FILE* f = std::fopen((carpeta / (std::string(nombre) + ".z24s8.bin")).string().c_str(), "wb")) {
+        std::fwrite(datos, 1, texels * 4, f);
+        std::fclose(f);
+      }
+    }
     if (alfa) {
       EscribirBmp(carpeta / (std::string(nombre) + "_alfa.bmp"), e.ancho, e.alto, a);
     }
-- 
2.43.0
